#:import dp kivy.metrics.dp

<InfoRow@BoxLayout>:
    label_text: ''
    value_text: ''
    size_hint_y: None
    height: dp(40)
    Label:
        text: root.label_text
        font_name: app.font_name
        font_size: '13sp'
        color: 0.6, 0.65, 0.75, 1
        size_hint_x: 0.35
        halign: 'right'
        text_size: self.size
        valign: 'middle'
    Label:
        text: root.value_text
        font_name: app.font_name
        font_size: '14sp'
        color: 1, 1, 1, 1
        halign: 'right'
        text_size: self.size
        valign: 'middle'


<AboutScreen>:
    name: 'about'
    BoxLayout:
        orientation: 'vertical'

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: dp(12), 0
            canvas.before:
                Color:
                    rgba: 0.09, 0.12, 0.2, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'عن التطبيق'
                font_name: app.font_name
                font_size: '20sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'right'
                text_size: self.size
                valign: 'middle'

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(16)

                Label:
                    text: 'أسترو سودان'
                    font_name: app.font_name
                    font_size: '26sp'
                    bold: True
                    color: 1, 0.85, 0.2, 1
                    size_hint_y: None
                    height: dp(40)
                    halign: 'center'
                    text_size: self.width, None

                Label:
                    text: 'أسترو سودان تطبيق بسيط يقرّبك من الكون كل يوم، بعرض صورة الفلك اليومية من ناسا بشرح مبسّط.'
                    font_name: app.font_name
                    font_size: '15sp'
                    color: 0.9, 0.9, 0.93, 1
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    halign: 'center'

                Widget:
                    size_hint_y: None
                    height: dp(8)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(14)
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: 0.09, 0.11, 0.17, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]

                    Label:
                        text: 'المطوّر'
                        font_name: app.font_name
                        font_size: '13sp'
                        color: 0.6, 0.65, 0.75, 1
                        size_hint_y: None
                        height: dp(24)
                        halign: 'right'
                        text_size: self.size

                    Label:
                        text: 'Elnzer Eshak Haroon'
                        font_name: app.font_name
                        font_size: '18sp'
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(28)
                        halign: 'right'
                        text_size: self.size

                    Label:
                        text: 'الهيئة العامة للأرصاد الجوي السوداني'
                        font_name: app.font_name
                        font_size: '14sp'
                        color: 0.8, 0.82, 0.88, 1
                        size_hint_y: None
                        height: dp(26)
                        halign: 'right'
                        text_size: self.size

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(14)
                    spacing: dp(6)
                    canvas.before:
                        Color:
                            rgba: 0.09, 0.11, 0.17, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10)]

                    Label:
                        text: 'تواصل'
                        font_name: app.font_name
                        font_size: '13sp'
                        color: 0.6, 0.65, 0.75, 1
                        size_hint_y: None
                        height: dp(24)
                        halign: 'right'
                        text_size: self.size

                    InfoRow:
                        label_text: 'البريد الإلكتروني'
                        value_text: root.contact_email
                        opacity: 1 if root.contact_email else 0
                        height: dp(40) if root.contact_email else 0

                    InfoRow:
                        label_text: 'فيسبوك'
                        value_text: root.contact_facebook
                        opacity: 1 if root.contact_facebook else 0
                        height: dp(40) if root.contact_facebook else 0

                    InfoRow:
                        label_text: 'إنستجرام'
                        value_text: root.contact_instagram
                        opacity: 1 if root.contact_instagram else 0
                        height: dp(40) if root.contact_instagram else 0

                    Label:
                        text: 'لم تُضف بيانات تواصل بعد'
                        font_name: app.font_name
                        font_size: '13sp'
                        color: 0.5, 0.55, 0.65, 1
                        size_hint_y: None
                        height: dp(30) if root.no_contact_info else 0
                        opacity: 1 if root.no_contact_info else 0
                        halign: 'right'
                        text_size: self.width, None

                InfoRow:
                    label_text: 'الإصدار'
                    value_text: root.app_version

        NavBar:
            NavButton:
                label_text: 'اليوم'
                on_release: app.go_to('today', 'right')
            NavButton:
                label_text: 'الأرشيف'
                on_release: app.go_to('archive', 'right')
            NavButton:
                label_text: 'بحث'
                on_release: app.go_to('search', 'right')
            NavButton:
                label_text: 'مساهماتي'
                on_release: app.go_to('contributions', 'right')
            NavButton:
                label_text: 'عن التطبيق'
                active: True
                on_release: app.go_to('about')
